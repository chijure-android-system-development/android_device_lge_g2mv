+        private boolean mayRequestGpsLocation(Context context) {
+            SharedPreferences prefs = context.getSharedPreferences(GPS_PREFS, MODE_PRIVATE);
+            long now = System.currentTimeMillis();
+            long last = prefs.getLong(KEY_LAST_GPS_REQUEST, 0);
+            // a value from the future means the clock went back: treat it as stale
+            if (last != 0 && last <= now && now - last < GPS_LOCATION_MIN_INTERVAL) {
+                return false;
+            }
+            prefs.edit().putLong(KEY_LAST_GPS_REQUEST, now).apply();
+            return true;
+        }
