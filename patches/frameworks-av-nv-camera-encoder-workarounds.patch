+    // g2mv/NvCamera: after NV AVC encode we skip freeNode (heap abort). That
+    // wedges the HAL — next open hangs with a black preview. Recycle
+    // mediaserver once no camera clients remain.
+    bool anyClient = false;
+    for (int i = 0; i < mNumberOfCameras; ++i) {
+        if (mClient[i] != 0) {
+            anyClient = true;
+            break;
+        }
+    }
+    if (!anyClient) {
+        if (access("/data/misc/media/nv_encoder_dirty", F_OK) == 0) {
+            unlink("/data/misc/media/nv_encoder_dirty");
+            ALOGI("NV encoder dirty: recycling mediaserver for preview reset");
+            pthread_t tid;
+            pthread_create(&tid, NULL, nvEncoderDirtyRecycleThread, NULL);
+            pthread_detach(tid);
+        }
+    }
