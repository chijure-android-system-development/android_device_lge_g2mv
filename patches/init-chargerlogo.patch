From: g2mv bring-up
Subject: init: run LG chargerlogo before Android boot

LG D625 offline charge sets androidboot.mode=chargerlogo. AOSP init only
treats mode=charger, so CM booted the full framework instead of the charge
UI. Queue the chargerlogo trigger (mount /system first), then early-boot/boot
after /sbin/chargerlogo exits (Power key).

Apply under system/core:
  patch -p1 < device/lge/g2mv/patches/init-chargerlogo.patch

--- a/init/init.c
+++ b/init/init.c
@@ -1110,6 +1110,7 @@ int main(int argc, char **argv)
     int property_set_fd_init = 0;
     int signal_fd_init = 0;
     int keychord_fd_init = 0;
     bool is_charger = false;
+    int is_chargerlogo = 0;
 
     if (!strcmp(basename(argv[0]), "ueventd"))
         return ueventd_main(argc, argv);
@@ -1176,6 +1177,8 @@ int main(int argc, char **argv)
     restorecon_recursive("/sys");
 
     is_charger = !strcmp(bootmode, "charger");
+    /* LG D625 and other LG bootloaders use chargerlogo for offline charge. */
+    is_chargerlogo = !strcmp(bootmode, "chargerlogo");
 
     INFO("property init\n");
     if (!is_charger)
@@ -1211,6 +1214,7 @@ int main(int argc, char **argv)
     action_for_each_trigger("init", action_add_queue_tail);
 
     if (!is_charger) {
+        /* chargerlogo still needs /system (vendor chargerimages). */
         action_for_each_trigger("early-fs", action_add_queue_tail);
         if(emmc_boot) {
             action_for_each_trigger("emmc-fs", action_add_queue_tail);
@@ -1239,6 +1243,11 @@ int main(int argc, char **argv)
 
     if (is_charger) {
         action_for_each_trigger("charger", action_add_queue_tail);
+    } else if (is_chargerlogo) {
+        /* Block in exec /sbin/chargerlogo, then continue to Android. */
+        action_for_each_trigger("chargerlogo", action_add_queue_tail);
+        action_for_each_trigger("early-boot", action_add_queue_tail);
+        action_for_each_trigger("boot", action_add_queue_tail);
     } else {
         action_for_each_trigger("early-boot", action_add_queue_tail);
         action_for_each_trigger("boot", action_add_queue_tail);
