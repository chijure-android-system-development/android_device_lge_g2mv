 #include <string.h>
 #include "nfa_sys.h"
 #include "nfa_api.h"
@@ -97,6 +98,35 @@ static void nfa_dm_module_init_cback (void)
     (*nfa_dm_cb.p_dm_cback) (NFA_DM_ENABLE_EVT, &dm_cback_data);
 }
 
+/*******************************************************************************
+**
+** Function         nfa_dm_recovery_init_cback
+**
+** Description      g2mv: NFCC sent CORE_RESET_NTF (PN547 resets when RF
+**                  discovery starts) and the NFC layer re-initialized it.
+**                  Re-enabling the sub-systems cleared the discovery
+**                  callback, so restart RF discovery if it was enabled.
+**                  Runs from a timer: EE and HCI do not report enable
+**                  complete again during recovery.
+**
+** Returns          None
+**
+*******************************************************************************/
+static TIMER_LIST_ENT nfa_dm_recovery_tle;
+
+static void nfa_dm_recovery_init_cback (TIMER_LIST_ENT *p_tle)
+{
+    (void) p_tle;
+    NFA_TRACE_WARNING1 ("nfa_dm_recovery_init_cback () disc_flags=0x%x",
+                        nfa_dm_cb.disc_cb.disc_flags);
+
+    if (nfa_dm_cb.disc_cb.disc_flags & NFA_DM_DISC_FLAGS_ENABLED)
+    {
+        /* also completes a pending stop with NFA_RF_DISCOVERY_STOPPED_EVT */
+        nfa_dm_start_rf_discover ();
+    }
+}
+
 /*******************************************************************************
 **
 ** Function         nfa_dm_nfcc_power_mode_proc_complete_cback
@@ -293,6 +323,41 @@ static void nfa_dm_nfc_response_cback (tNFC_RESPONSE_EVT event, tNFC_RESPONSE *p
                     }
                 }
             }
+            if (!(nfa_dm_cb.flags & NFA_DM_FLAGS_ENABLE_EVT_PEND))
+            {
+                /* g2mv: NFCC reset recovery while NFA was already enabled.
+                ** The NFCC is back in RF IDLE; forget the old discovery
+                ** state and restart it once the sub-systems are set up.
+                ** Give up restarting after 3 recoveries in 30 s so a NFCC
+                ** that resets on every RF start cannot loop forever. */
+                static time_t recovery_secs[3];
+                static UINT8  recovery_idx;
+                struct timespec ts;
+                time_t now;
+                BOOLEAN looping;
+
+                clock_gettime (CLOCK_MONOTONIC, &ts);
+                now = ts.tv_sec + 1;    /* 0 marks an unused slot */
+                looping = (recovery_secs[recovery_idx] != 0)
+                        && ((now - recovery_secs[recovery_idx]) < 30);
+
+                recovery_secs[recovery_idx] = now;
+                recovery_idx = (recovery_idx + 1) % 3;
+
+                NFA_TRACE_WARNING2 ("NFCC reset recovery: disc_state=%d looping=%d",
+                                    nfa_dm_cb.disc_cb.disc_state, looping);
+                nfa_dm_cb.disc_cb.disc_state = NFA_DM_RFST_IDLE;
+                nfa_dm_cb.disc_cb.disc_flags &= ~(NFA_DM_DISC_FLAGS_W4_RSP
+                                                  |NFA_DM_DISC_FLAGS_W4_NTF
+                                                  |NFA_DM_DISC_FLAGS_CHECKING);
+                if (!looping)
+                {
+                    nfa_dm_recovery_tle.p_cback = (TIMER_CBACK *) nfa_dm_recovery_init_cback;
+                    nfa_sys_start_timer (&nfa_dm_recovery_tle, 0, 300);
+                }
+                else if (nfa_dm_cb.disc_cb.disc_flags & NFA_DM_DISC_FLAGS_STOPPING)
+                    nfa_dm_start_rf_discover ();
+            }
             /* Initialize NFA subsystems */
             nfa_sys_enable_subsystems ();
         }
