From: g2mv bring-up
Subject: libnfc-nci: do not treat CORE_RESET_NTF payload as NCI version

PN547 emits proprietary CORE_RESET_NTF (reason 0xA0). Parsing the next
byte as NCI version makes recovery fail with "NFCC version is too old".

Apply under external/libnfc-nci:
  patch -p1 < device/lge/g2mv/patches/libnfc-nci-reset-ntf-version.patch

diff --git a/src/nfc/nfc/nfc_ncif.c b/src/nfc/nfc/nfc_ncif.c
index 614465e..0f56cd9 100644
--- a/src/nfc/nfc/nfc_ncif.c
+++ b/src/nfc/nfc/nfc_ncif.c
@@ -1356,7 +1356,11 @@ void nfc_ncif_proc_reset_rsp (UINT8 *p, BOOLEAN is_ntf)
 
     if (status == NCI_STATUS_OK)
     {
-        if ((*p) != NCI_VERSION)
+        /* CORE_RESET_RSP carries NCI version; CORE_RESET_NTF (incl. NXP
+         * proprietary reason 0xA0 used by PN547) does not. Validating the
+         * next payload byte as a version makes recovery fail with
+         * "NFCC version is too old" on g2mv. */
+        if (!is_ntf && (*p) != NCI_VERSION)
         {
             NFC_TRACE_DEBUG2 ("NCI version mismatch!!:0x%02x != 0x%02x ", NCI_VERSION, *p);
             if ((*p) < NCI_VERSION_0_F)
