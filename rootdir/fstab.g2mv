# Android fstab file.
#<src>                                                  <mnt_point>         <type>    <mnt_flags>                                                    <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

/dev/block/platform/sdhci-tegra.3/by-name/APP           /system             ext4      ro,barrier=1,noatime                                                            wait,check
/dev/block/platform/sdhci-tegra.3/by-name/CAC           /cache              ext4      nosuid,nodev,barrier=1,noatime,noauto_da_alloc,errors=continue    wait,check
/dev/block/platform/sdhci-tegra.3/by-name/UDA           /data               ext4      nosuid,nodev,barrier=1,noatime,noauto_da_alloc,errors=continue wait,check,encryptable=/dev/block/platform/sdhci-tegra.3/by-name/MDA
/devices/platform/sdhci-tegra.2/mmc_host/mmc1           /storage/external_SD vfat      nosuid,nodev                                                  wait,voldmanaged=external_SD:auto
/devices/platform/tegra-ehci.0                          auto                vfat      defaults                                                       voldmanaged=USBstorage1:auto
/devices/platform/tegra-ehci.1                          auto                vfat      defaults                                                       voldmanaged=USBstorage1:auto
/dev/block/platform/sdhci-tegra.3/by-name/CST          /cust                ext4      rw,nodev,barrier=1,noauto_da_alloc wait

# Icera modem partition
/dev/block/platform/sdhci-tegra.3/by-name/MDM           /mnt/modem          ext4      noatime,nosuid,nodev,data=ordered,errors=continue                 wait,check
