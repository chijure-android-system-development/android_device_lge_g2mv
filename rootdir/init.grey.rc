import init.grey.usb.rc

# Set up HDCP
import init.hdcp.rc

# Nvidia baseband integration
import init.modem_${ro.boot.modem}.rc

on early-init
    mount debugfs debugfs /sys/kernel/debug

on init
    mkdir /mnt/modem
    # Set permissions for persist partition
    mkdir /persist 0771 system system
    # See storage config details at http://source.android.com/tech/storage/
    mkdir /mnt/shell/emulated 0700 shell shell
    mkdir /mnt/media_rw 0700 media_rw media_rw
    mkdir /storage 0751 system sdcard_r
    mkdir /mnt/shell/emulated 0700 shell shell
    mkdir /storage/emulated 0555 root root
    mkdir /storage/emulated/legacy 0555 root root
    mkdir /mnt/media_rw/external_SD 0700 media_rw media_rw
    mkdir /storage/external_SD 0700 root root
	mkdir /cust 0775 system system

    export EXTERNAL_STORAGE /storage/emulated/legacy
    export EXTERNAL_ADD_STORAGE /storage/external_SD
    export SECONDARY_STORAGE /storage/external_SD
    export EMULATED_STORAGE_SOURCE /mnt/shell/emulated
    export EMULATED_STORAGE_TARGET /storage/emulated

    # Support legacy paths
    symlink /storage/emulated/legacy /sdcard
    symlink /storage/emulated/legacy /mnt/sdcard
    symlink /storage/emulated/legacy /storage/sdcard0
    symlink /mnt/shell/emulated/0 /storage/emulated/legacy

    # create directory for mounting usb drives
    mkdir /mnt/media_rw/USBstorage1 0700 media_rw media_rw

    mkdir /storage/USBstorage1 0700 root root

    export EXTERNAL_ADD_USB_STORAGE /storage/USBstorage1

    symlink /mnt/media_rw/USBstorage1 /storage/USBstorage1
    symlink /mnt/media_rw/USBstorage1 /USBstorage1
    # Create filesystems if necessary.
    # LGE_UPDATE_START, 2013/01/31, G2-FS@lge.com
    exec /sbin/setup_fs_static \
        /dev/block/platform/sdhci-tegra.3/by-name/UDA \
        /dev/block/platform/sdhci-tegra.3/by-name/CAC \
        /dev/block/platform/sdhci-tegra.3/by-name/PST \
        /dev/block/platform/sdhci-tegra.3/by-name/MDM \
        /dev/block/platform/sdhci-tegra.3/by-name/DRM \
        /dev/block/platform/sdhci-tegra.3/by-name/SNS \
        /dev/block/platform/sdhci-tegra.3/by-name/MPT \
		/dev/block/platform/sdhci-tegra.3/by-name/CST \
        no_reboot
    # LGE_UPDATE_END

    # set size of zram as 2047MB
    # write /sys/class/block/zram0/disksize 2047M

    #Preoccupy properties for encryption process(mudzizi.kim@lge.com)
#    setprop vold.decrypt ""
#    setprop vold.encrypt_progress ""

on fs
    setprop ro.crypto.tmpfs_options size=128m,mode=0771,uid=1000,gid=1000
    setprop ro.crypto.umount_sd false
    setprop ro.crypto.fuse_sdcard true
    setprop ro.crypto.fuse_usbdrive false
    # Executing tune2fs to reserve some region in /data. (40MiB)
#    exec /system/bin/tune2fs -u system -r 10240 /dev/block/platform/sdhci-tegra.3/by-name/UDA

on post-fs-data
    mkdir /data/misc/wifi 0771 wifi system
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wifi/firmware 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    mkdir /data/nvcam 0700 media camera
    chown dhcp dhcp /data/misc/dhcp

    mkdir /data/misc/wminput 0776 system system

    mkdir /data/media 0770 media_rw media_rw

    # Set indication (checked by vold) that we have finished this action
    setprop vold.post_fs_data_done 1

    # Create GPS folders and set its permissions
    mkdir /data/gps
    chown gps system /data/gps/
    chmod 0770 /data/gps/

    # taesook.yoon@lge.com set gps UART & daemon permissons
    chown gps system /dev/ttyHS1
    chmod 0660 /dev/ttyHS1
    chown system system /system/bin/glgps
    chown system system /system/bin/gpslogd
    chown system system /system/etc/gps/gpsconfig.xml
    # taesook.yoon@lge.com set gps UART & daemon permissons

    chmod 0600 /dev/bcm2079x
    chown nfc nfc /dev/bcm2079x
    mkdir /data/nfc
    mkdir /data/nfc/param
    chmod 0700 /data/nfc
    chmod 0700 /data/nfc/param
    chown nfc nfc /data/nfc
    chown nfc nfc /data/nfc/param

    # we will remap this as /mnt/sdcard with the sdcard fuse tool
    mkdir /data/media 0770 media_rw media_rw
    chown media_rw media_rw /data/media

	mkdir /data/misc/audit 02750 system system

on boot

# bluetooth
    # change back to bluetooth from system
    chown bluetooth net_bt_stack /data/misc/bluetooth

    # UART device
    chmod 0660 /dev/ttyHS2
    chown bluetooth net_bt_stack /dev/ttyHS2

    # UEI IR blaster: stock librctransport hardcodes /dev/ttyAS1 while the
    # Tegra UART node is ttyHS3 (also listed in /system/etc/serialport.txt).
    symlink /dev/ttyHS3 /dev/ttyAS1
    chmod 0660 /dev/ttyHS3
    chown system system /dev/ttyHS3

    # power up/down interface
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/type
    chmod 0660 /proc/bluetooth/sleep/btwake
    chmod 0660 /proc/bluetooth/sleep/proto

    write /sys/class/rfkill/rfkill0/state 0
    chown bluetooth net_bt_stack /sys/class/rfkill/rfkill0/state
    chown bluetooth net_bt_stack /sys/class/rfkill/rfkill0/type
    chown bluetooth net_bt_stack /proc/bluetooth/sleep/btwake
    chown bluetooth net_bt_stack /proc/bluetooth/sleep/proto

    # bluetooth MAC address programming
    chown bluetooth net_bt_stack /system/etc/bluetooth
    chown bluetooth net_bt_stack /data/misc/bluetooth
#    chown bluetooth net_bt_stack ro.bt.bdaddr_path
#    setprop ro.bt.bdaddr_path "/data/misc/bluetooth/bdaddr"

# Tegra wakeup monitor
    chown system system /sys/devices/platform/tegra_wakeup_monitor/cmd
    chown system system /sys/devices/platform/tegra_wakeup_monitor/monitor_enable
    chown system system /sys/devices/platform/tegra_wakeup_monitor/nf_enable
    chown system system /sys/devices/platform/tegra_wakeup_monitor/am_enable
    chown system system /sys/devices/platform/tegra_wakeup_monitor/init_ports
    chown system system /sys/devices/platform/tegra_wakeup_monitor/add_ports
    chown system system /sys/devices/platform/tegra_wakeup_monitor/del_ports
# Wifi support rx-filter
    setprop wifi.rx-filter 1

#[START] Battery Fake mode 2014.01.07 donghyuk79.park
    chown system system /sys/class/power_supply/battery/pseudo_batt
	chmod 0660 /sys/class/power_supply/battery/pseudo_batt
#[END] Battery Fake mode 2014.01.07 donghyuk79.park

#[START] excutes smpl_count 2014.01.07 donghyuk79.park
    exec /system/bin/smpl_count
#[END] excute smpl_count 2014.01.07 donghyuk79.park

# audio
    chmod 0664 /sys/power/suspend/mode
    chown system audio /sys/power/suspend/mode

#NFC
    setprop ro.nfc.port "I2C"

# nvdps
    chown system system /sys/class/graphics/fb0/device/nvdps

# backlight: panel is RT8542-bled (leds/lcd-backlight). lights.g2mv.so opens
# pwm-backlight first and never updates the real LED, leaving a black screen.
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/brightness
    chmod 0000 /sys/class/backlight/pwm-backlight/brightness
    write /sys/class/leds/lcd-backlight/brightness 180
# flash / torch (RT8542; CM Torch overlay points here).
# World-writable so the Torch app (not system UID) can toggle the LED.
    chown system system /sys/class/leds/RT8542-fled/brightness
    chmod 0666 /sys/class/leds/RT8542-fled/brightness
# vibrator (max77660 haptic; also used by BOARD_HAS_VIBRATOR_IMPLEMENTATION)
    chown system system /sys/class/input/event1/device/device/vibrator_enable
    chown system system /sys/class/input/event2/device/device/vibrator_enable
    chown system system /sys/class/input/event3/device/device/vibrator_enable
    chown system system /sys/devices/platform/tegra14-i2c.4/i2c-4/4-0023/max77660-vibrator/vibrator_enable
    chmod 0660 /sys/devices/platform/tegra14-i2c.4/i2c-4/4-0023/max77660-vibrator/vibrator_enable
# NFC: NCI HAL opens /dev/pn544; kernel node is pn547
    symlink /dev/pn547 /dev/pn544
    chmod 0660 /dev/pn547
    chown nfc nfc /dev/pn547

# didim
    chown system system /sys/class/graphics/fb0/device/smartdimmer/enable
    chown system system /sys/class/graphics/fb0/device/smartdimmer/aggressiveness
    chown system system /sys/class/graphics/fb0/device/smartdimmer/sd_window
    chown system system /sys/class/graphics/fb0/device/smartdimmer/sd_window_enable

# power
    chown system system /sys/kernel/tegra_cap/core_cap_level
    chown system system /sys/kernel/tegra_cap/core_cap_state
    chown system system /sys/module/cpu_tegra/parameters/cpu_user_cap

# WDT
    write /sys/devices/platform/tegra14-i2c.4/i2c-4/4-0023/max77660-sys-wdt/power/wakeup enabled

# Touch
    chown system system /sys/class/input/input0/enabled
    chown system system /sys/class/input/input1/enabled
    # APDS9930 ALS/PS sysfs for sensors.g2mv LightSensor/ProximitySensor
    chown system system /sys/class/input/input0/device/enable
    chown system system /sys/class/input/input0/device/poll_delay
    chown system system /sys/class/input/input0/device/enable_als_sensor
    chown system system /sys/class/input/input1/device/enable
    chown system system /sys/class/input/input1/device/enable_ps_sensor
    chmod 0664 /sys/class/input/input0/device/enable
    chmod 0664 /sys/class/input/input0/device/poll_delay
    chmod 0664 /sys/class/input/input0/device/enable_als_sensor
    chmod 0664 /sys/class/input/input1/device/enable
    chmod 0664 /sys/class/input/input1/device/enable_ps_sensor
#	chmod 664 /sys/devices/virtual/input/lge_touch/touch_gesture
#	chown system system /sys/devices/virtual/input/lge_touch/touch_gesture
    chmod 664 /sys/devices/virtual/input/lge_touch/knock_on_type
    chown system system /sys/devices/virtual/input/lge_touch/knock_on_type
    chmod 664 /sys/devices/virtual/input/lge_touch/lpwg_notify
    chown system system /sys/devices/virtual/input/lge_touch/lpwg_notify
    chmod 664 /sys/devices/virtual/input/lge_touch/lpwg_data
    chown system system /sys/devices/virtual/input/lge_touch/lpwg_data
    chmod 664 /sys/devices/virtual/input/lge_touch/global_access_pixel
	chown system system /sys/devices/virtual/input/lge_touch/global_access_pixel
    chmod 664 /sys/devices/virtual/input/lge_touch/incoming_call
    chown system system /sys/devices/virtual/input/lge_touch/incoming_call
    chmod 664 /sys/devices/virtual/input/lge_touch/lockscreen
    chown system system /sys/devices/virtual/input/lge_touch/lockscreen


# Sensor
    # Accelerometer and Maganetometer Sensor
    chown system system /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0011/cal_result
    chmod 0660          /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0011/cal_result
    chown system system /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0011/run_calibration
    chmod 0660          /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0011/run_calibration
    chown system system /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0011/selftest
    chmod 0660          /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0011/selftest
    chown system system /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0011/softreset
    chmod 0660          /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0011/softreset

    # Proximity + ALS (APDS993x at 0-0039)
    chown system system /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/pdata
    chmod 0660          /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/pdata
    chown system system /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/ps_detection
    chmod 0660          /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/ps_detection
    chown system system /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/enable_ps_sensor
    chmod 0660          /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/enable_ps_sensor
    chown system system /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/enable_als_sensor
    chmod 0660          /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/enable_als_sensor
    chown system system /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/enable
    chmod 0660          /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/enable
    chown system system /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/poll_delay
    chmod 0660          /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/poll_delay
    chown system system /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/ps_run_calibration
    chmod 0660          /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/ps_run_calibration
    chown system system /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/ps_cal_result
    chmod 0660          /sys/devices/platform/tegra14-i2c.0/i2c-0/0-0039/ps_cal_result

# Power management settings
    #write /sys/module/tegra3_emc/parameters/emc_enable 0
    #write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 1000000

    write /sys/module/tegra14_emc/parameters/pasr_enable 1

    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor conservative
    write /sys/devices/system/cpu/cpufreq/conservative/up_threshold 80
    write /sys/devices/system/cpu/cpufreq/conservative/down_threshold 30
    write /sys/devices/system/cpu/cpufreq/conservative/freq_step 5

    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq 768000
    write /sys/devices/system/cpu/cpufreq/interactive/target_loads "65 228000:75 768000:85"
    write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay 20000
    write /sys/devices/system/cpu/cpufreq/interactive/io_busy_threshold 50
    write /sys/devices/system/cpu/cpufreq/interactive/io_is_busy 1

    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/no_lp 0
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/down_delay 500
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/idle_top_freq 408000
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/enable 1
    write /sys/devices/system/cpu/cpuquiet/current_governor runnable

    write /sys/module/cpuidle/parameters/power_down_in_idle 1
    write /sys/module/cpuidle_t14x/parameters/cpu_power_gating_in_idle 0x1f
    write /sys/module/cpuidle_t14x/parameters/fast_cluster_power_down_mode 0
    write /sys/module/cpuidle_t14x/parameters/slow_cluster_power_gating_noncpu 1
    write /sys/module/cpuidle_t14x/parameters/stop_mc_clk_in_idle 1

    chown system system /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/no_lp
    chown system system /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load

    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    chown system system /sys/devices/tegradc.0/enable
    chown system system /sys/devices/tegradc.1/enable
    chown system system /sys/devices/platform/host1x/nvavp/boost_sclk

    chown system system /sys/kernel/tegra_cap/cbus_cap_level
    chown system system /sys/kernel/tegra_cap/cbus_cap_state
    chown system system /sys/devices/platform/host1x/gr3d/enable_3d_scaling

# Set battery poll interval
    write /sys/module/bq27x00_battery/parameters/poll_interval 30

# Default Read Ahead value for sdcards
    write /sys/block/mmcblk0/queue/read_ahead_kb 2048
    write /sys/block/mmcblk1/queue/read_ahead_kb 2048

# Wiimote connect status
    write /data/misc/wminput/connected 0
    chmod 0666 /data/misc/wminput/connected

# GPS init (BCM4752 nSTDBY on gpio63; glgps toggles value, needs gps/system write)
    write /sys/class/gpio/export 63
    write /sys/class/gpio/gpio63/value 0
    write /sys/class/gpio/gpio63/direction out
    chown gps system /sys/class/gpio/gpio63/value
    chmod 0660 /sys/class/gpio/gpio63/value

# USB On The Go - Host Mode
    chown system system /sys/devices/platform/tegra-otg/enable_host

# set hwui properties depending on the screen resolution and the memory size
    setprop vold.post_fs_data_done 1
    #Set default sdcard fs type
    setprop vold.sdcard_fs_type none

# Offline charge: bootloader sets androidboot.mode=chargerlogo. init queues
# this trigger before early-boot/boot; exec blocks until Power starts Android.
on chargerlogo
   write /sys/class/leds/lcd-backlight/brightness 180
   exec /sbin/chargerlogo

service auditd /system/bin/auditd -k
	class main

service set_hwui_params /system/bin/set_hwui_params.sh
    class main
    user root
    group root
    oneshot

# Set Zram parameters and initialise it as swap
service init_zram /system/bin/init_zram.sh
    class main
    user root
    group root
    oneshot

# CPU Boost: boost CPU on input events
service input-cfboost /system/bin/input_cfboost_init.sh
    class main
    user root
    group root
    oneshot

# DirectTouch: Raydium
#service rm_ts_service    /system/bin/rm_ts_server
#    disabled
#    class late_start
#    user system
#    group system input

#on property:ro.boot.touch_vendor_id=0
#    start rm_ts_service

#on property:ro.boot.touch_vendor_id=1
#    write /sys/devices/sensor00/sensor00.fn01/nosleep 0

service dhcpcd_p2p_p2p0 /system/bin/dhcpcd p2p-p2p0-0
    class main
    disabled
    oneshot

on property:vold.decrypt=trigger_restart_framework
    setprop ro.fuse_sdcard ${persist.fuse_sdcard}
service dhcpcd_wlan0 /system/bin/dhcpcd -aABKL
    class main
    disabled
    oneshot

service dhcpcd_p2p /system/bin/dhcpcd -aABKL
    class main
    disabled
    oneshot

service dhcpcd_eth0 /system/bin/dhcpcd -ABKL -f/system/etc/dhcpcd/dhcpcd.conf
     class main
     disabled
     oneshot

service dhcpcd_bt-pan /system/bin/dhcpcd -ABKL
    class main
    disabled
    oneshot

service iprenew_bt-pan /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

service iprenew_wlan0 /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

service iprenew_p2p /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

service iprenew_eth0 /system/bin/dhcpcd -n
    class main
    disabled
    oneshot


service sdcard /system/bin/sdcard -u 1023 -g 1023 -l /data/media /mnt/shell/emulated
     class late_start

service fuse_external_SD /system/bin/sdcard -u 1023 -g 1023 -w 1023 -d /mnt/media_rw/external_SD /storage/external_SD
    class late_start
    disabled

service fuse_USBstorage1 /system/bin/sdcard -u 1023 -g 1023 -w 1023 -d /mnt/media_rw/USBstorage1 /storage/USBstorage1
    class late_start
    disabled

# AOSP offline charge uses healthd-charger from init.rc (class charger).
# LG offline charge uses the chargerlogo trigger above, not this class.

# bugreport is triggered by the VOLUME-DOWN and VOLUME-UP keys
service bugreport /system/bin/dumpstate -d -v -o /data/storage/bugreports/bugreport
    class main
    disabled
    oneshot
    keycodes 115 114

# btmacwriter - to create unique BD address
service btmacwriter /system/bin/btmacwriter
    class main
    user bluetooth
    group bluetooth net_bt_admin
    oneshot

# Start GPS daemon
on boot
    service gps-daemon /system/bin/glgps -c /system/etc/gps/gpsconfig.xml
    user gps
    socket gps seqpacket 0660 gps system
    group system inet sdcard_rw sdcard_r
    class late_start

# sensor daemon
service sensord /system/bin/sensord
    class late_start
    user root
    oneshot

# wifiloader - set the wifi commchip_id accordingly
# [BEGIN][LGE_WIFI][neo-wifi@lge.com]: remove wifi_loader.sh, insmod at wifi.c
#service wifiloader /system/bin/wifi_loader.sh
#    class main
#    user root
#    group root

# Load bcmdhd early; WifiHW also insmods via WIFI_DRIVER_MODULE_PATH if needed.
on boot
    insmod /system/lib/modules/bcmdhd.ko
    write /proc/sys/net/core/wmem_default 262144
    write /proc/sys/net/core/wmem_max 262144

# [END][LGE_WIFI][neo-wifi@lge.com]

# Mount usb drives as /usbdrive. Generally usb drives are formatted with FAT
# filesystem, so we support FAT as of now.
on device-added-/sys/block/sda
  mount vfat /dev/block/sda /mnt/media_rw/usbdrive

on device-removed-/sys/block/sda
  umount /mnt/media_rw/usbdrive

# TLK storage service
import init.tlk.rc

# PowerService needs libpowerservice_client.so (missing from extract) and
# crash-loops; leave disabled — stock CM power path is enough.
service powerservice /system/bin/powerservice
    class main
    user system
    group system
    disabled
    oneshot

# create filesystems if necessary
service setup_fs /system/bin/setup_fs \
        /dev/block/platform/sdhci-tegra.3/by-name/UDA \
        /dev/block/platform/sdhci-tegra.3/by-name/CAC \
        /dev/block/platform/sdhci-tegra.3/by-name/MDM
    class core
    user root
    group root
    oneshot

service dns_masq /system/bin/dnsmasq --no-daemon --no-resolv --no-poll --dhcp-option-force=43,ANDROID_METERED --dhcp-range=192.168.42.2,192.168.42.254,1h &
    class main
    user dhcp
    group dhcp wifi system
    disabled
    oneshot

# LGE_CHANGE_S, [WiFi][neo-wifi@lge.com], 2013-12-14, Wifi Bring Up
service p2p_supplicant /system/bin/logwrapper /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets -N \
    -ip2p0 -Dnl80211 -c/data/misc/wifi/p2p_supplicant.conf \
    -I/system/etc/wifi/p2p_supplicant.conf \
    -puse_p2p_group_interface=1use_multi_chan_concurrent=1 -e/data/misc/wifi/entropy.bin \
    -g@android:wpa_wlan0
    #   we will start as root and wpa_supplicant will switch to user wifi
    #   after setting up the capabilities required for WEXT
    #   user wifi
    #   group wifi inet keystore
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service wpa_supplicant /system/bin/logwrapper /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets \
    -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0
    #   we will start as root and wpa_supplicant will switch to user wifi
    #   after setting up the capabilities required for WEXT
    #   user wifi
    #   group wifi inet keystore
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

# LGE_CHANGE_E, [WiFi][neo-wifi@lge.com], 2013-12-14, Wifi Bring Up
on property:persist.commchip_device=0xa94d
    symlink /system/etc/libnfc-brcm-43341.conf /data/nfc/libnfc-brcm.conf
    symlink /system/etc/libnfc-brcm-43341b00.conf /data/nfc/libnfc-brcm-43341b00.conf

on property:persist.commchip_device=0x4335
    symlink /system/etc/libnfc-brcm-4335.conf /data/nfc/libnfc-brcm.conf
    symlink /system/etc/libnfc-brcm-20791b04.conf /data/nfc/libnfc-brcm-20791b04.conf

# Configure modem
on boot
    service config_modem /system/bin/grey_mdm_boot_cfg.sh
    class late_start
    user root
    group root
    oneshot

# unified scaling setup
service ussr_setup /system/bin/ussr_setup.sh
    class main
    user root
    group root
    oneshot

# unified scaling process
service ussrd /system/bin/ussrd
    user system
    group system
    class main

on property:ro.fuse_sdcard=true
    start sdcard
    start fuse_sdcard

# Binding fuse mount point to /storage/emulated/legacy
 on property:init.svc.sdcard=running
    wait /mnt/shell/emulated/0
    mount none /mnt/shell/emulated/0 /storage/emulated/legacy bind

# This will make sure that sdcard service starts as late_start.
on nonencrypted
    setprop ro.fuse_sdcard ${persist.fuse_sdcard}

service usdwatchdog /system/bin/usdwatchdog --wait 30
    user system
    group system
    class main

# Enable rbe
# thresIncr:50  thresIncrCntMax:6  thresDecr:70  thresDecrCntMax:2
# The change from default is the thresDecrCntMax.  Default is 3.
service wlbwservice /system/bin/wlbwservice -t 50 6 70 2
    class main
    user system
    group system inet net_admin

# 2012.08.24 real-wifi@lge.com[wo0gi] TestMode Daemon for broadcom driver [START]
service diagd /system/bin/diagd
	class late_start
	user root
	group radio system
	disabled
	oneshot
	socket lsock_diagd stream 666

on property:wifi_ftm.diagd_start=1
    start diagd

on property:wifi_ftm.diagd_start=0
    stop diagd
# 2012.08.24 real-wifi@lge.com[wo0gi] TestMode Daemon for broadcom driver [END]

# Factory, ATD
service atd /system/bin/atd /dev/ttyGS0 /dev/ttyGS1 /dev/ttySHM11
    socket atd stream 0660 system inet
    class main

on property:gsm.modem.ril.recoveryatd=1
    start atd
on property:gsm.modem.ril.recoveryatd=0
    stop atd

on property:gsm.modem.icera.atd=start
    start atd
on property:gsm.modem.icera.atd=stop
    stop atd

#LGE_CHANGE_S 2013.12.26 lg-msp@lge.com MTS TEAM
service mtsd /system/bin/mtsd
    class late_start
    oneshot
    socket mtsd.port stream 660 system system

#    on property:sys.mts.forcemts=1
#    start mtsd
#    on property:sys.mts.forcemts=0
#    stop mtsd
#LGE_CHANGE_E 2013.12.26 lg-msp@lge.com MTS TEAM

# LGE Hidden reset
service service-hreset /system/bin/sh /init.hreset.sh
   class main
   disabled
   oneshot

on property:persist.service.hreset.enable=1
   stop service-hreset
   start service-hreset

# For SDCard Encryption
on init
    setprop ro.ssbd.session /dev/block/platform/sdhci-tegra.3/by-name/SEP
    setprop ro.ssbd.offset 0
service ssbd /system/bin/ssbd
    class main
    socket ssbd stream 0660 root mount

#BT_S : [PSIX-5377]BDADDR_LOADER
service bdaddr_loader /system/bin/bdaddr_loader
    user root
    group bluetooth net_bt_admin misc net_bt_stack
    disabled
    oneshot
#BT_E : [PSIX-5377]BDADDR_LOADER

#touch firmware upgrade on hiddenmenu
on property:sys.lge.touchfirmware.update=1
    write /sys/devices/virtual/input/lge_touch/fw_upgrade 1
    setprop sys.lge.touchfirmware.update 2

on property:sys.lge.touchsensingtest=1
    write /sys/devices/virtual/input/lge_touch/sensing_test 1
on property:sys.lge.touchsensingtest=0
    write /sys/devices/virtual/input/lge_touch/sensing_test 0
    setprop sys.lge.touchsensingtest 2

on property:ril.lge.touch.callstate=0
    write /sys/devices/virtual/input/lge_touch/incoming_call 0
on property:ril.lge.touch.callstate=1
    write /sys/devices/virtual/input/lge_touch/incoming_call 1
on property:ril.lge.touch.callstate=2
    write /sys/devices/virtual/input/lge_touch/incoming_call 2

on property:service.keyguard.status=0
    write /sys/devices/virtual/input/lge_touch/lockscreen 0
on property:service.keyguard.status=1
    write /sys/devices/virtual/input/lge_touch/lockscreen 1
on property:service.keyguard.status=2
    write /sys/devices/virtual/input/lge_touch/lockscreen 2

# Customers should remove this line
import init.qvs.rc

# LGE Log Service


on post-fs
    # last_kmsg back-up
    exec /system/bin/sh /system/bin/last_kmsg_backup.sh
