# LG D625 / g2mv, extracted from the stock recovery ramdisk.
# CM11 recovery and its OTA tools require Android fstab v2:
# <device> <mount point> <fs type> <mount flags> <fs_mgr flags>
/dev/block/platform/sdhci-tegra.3/by-name/SOS  /recovery  emmc  defaults  defaults
/dev/block/platform/sdhci-tegra.3/by-name/LNX  /boot      emmc  defaults  defaults
/dev/block/platform/sdhci-tegra.3/by-name/APP  /system    ext4  rw        wait
/dev/block/platform/sdhci-tegra.3/by-name/CAC  /cache     ext4  rw        wait
# The stock fstab keeps the crypto footer in MDA, not at the end of UDA.
/dev/block/platform/sdhci-tegra.3/by-name/UDA  /data      ext4  rw        wait,encryptable=/dev/block/platform/sdhci-tegra.3/by-name/MDA
/dev/block/platform/sdhci-tegra.3/by-name/MSC  /misc      emmc  defaults  defaults
/dev/block/platform/sdhci-tegra.3/by-name/USP  /staging   emmc  defaults  defaults
/dev/block/platform/sdhci-tegra.3/by-name/MDA  /encrypt   emmc  defaults  defaults

# Device-specific LG/Icera partitions. They are backed up as raw images so a
# ROM change cannot silently lose modem, calibration or carrier data.
/dev/block/platform/sdhci-tegra.3/by-name/MDM  /modem  emmc  defaults  defaults
/dev/block/platform/sdhci-tegra.3/by-name/CST  /cust   emmc  defaults  defaults
/dev/block/platform/sdhci-tegra.3/by-name/MPT  /mpt    emmc  defaults  defaults
/dev/block/platform/sdhci-tegra.3/by-name/PST  /pst    emmc  defaults  defaults
/dev/block/platform/sdhci-tegra.3/by-name/SNS  /sns    emmc  defaults  defaults
/dev/block/platform/sdhci-tegra.3/by-name/RCT  /rct    emmc  defaults  defaults
/dev/block/platform/sdhci-tegra.3/by-name/DRM  /drm    emmc  defaults  defaults
/dev/block/platform/sdhci-tegra.3/by-name/SEP  /sep    emmc  defaults  defaults

/dev/block/platform/sdhci-tegra.2/by-num/p1  /external_sd  auto  defaults  voldmanaged=sdcard1:auto
